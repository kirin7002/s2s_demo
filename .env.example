# Copy to .env and fill these two fields locally. Never commit real credentials.
DASHSCOPE_API_KEY=
S2S_DEMO_PASSWORD=
S2S_ENABLE_LIVE=1
S2S_ORIGIN=http://127.0.0.1:8080
QWEN_REGION=cn-beijing
QWEN_MODEL=qwen-audio-3.0-realtime-flash
QWEN_WORKSPACE_ID=
QWEN_VOICE=
# Optional single demo device; leave disabled until configured locally.
S2S_STACKCHAN_ENABLED=0
S2S_STACKCHAN_DEVICE_ID=
# Independent device bearer token, 32-256 URL-safe characters. Never a model key.
S2S_STACKCHAN_DEVICE_TOKEN=
# Optional temporary acceptance limit; blank uses the device-advertised ranges.
S2S_STACKCHAN_TEST_MAX_DEG=
# Text-free motion summary/status logs only; no microphone or screen text.
S2S_STACKCHAN_AUDIT=0
